# Base vision model
FROM qwen3.5:4b

# Sampling parameters tuned for high-energy hallucination and tabloid drama
PARAMETER temperature 1.6
PARAMETER top_p 0.95
PARAMETER frequency_penalty 0.2
PARAMETER presence_penalty 0.4

# System persona: Aya Shameimaru / Bunbunmaru Newspaper chief reporter
